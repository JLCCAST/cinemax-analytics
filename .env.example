# Copia este archivo como .env y cambia las contraseñas.

# Código de CineMax: de aquí salen las migraciones y el init-script de MongoDB.
CINEMAX_REPO=./cinemax

# Usuario de las 5 bases de origen. No uses "root": MySQL lo rechaza.
FUENTES_USER=cinemax
FUENTES_PASSWORD=cambia-esta-clave

# Warehouse
DWH_USER=analytics
DWH_PASSWORD=cambia-esta-otra-clave
DWH_DB=cinemax_dwh

# Puertos, publicados solo en 127.0.0.1
PUERTO_USUARIOS=15433
PUERTO_FACTURACION=15434
PUERTO_SUCURSALES=13307
PUERTO_CONFITERIA=13308
PUERTO_CARTELERA=27018
PUERTO_DWH=5440

# dbt
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt

# Agente (fase 4)
AGENTE_DWH_PASSWORD=cambia-esta-clave-del-agente
GEMINI_API_KEY=
AGENTE_MODELO=gemini-2.5-flash
